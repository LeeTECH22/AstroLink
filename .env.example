# ============================================================
# AstroLink environment variables (example)
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file.
# ============================================================

# NASA API key - BACKEND ONLY. Get a free key at https://api.nasa.gov/
# Read server-side as process.env.NASA_API_KEY; never sent to the browser.
NASA_API_KEY=YOUR_NASA_API_KEY_HERE

# Optional: additional NASA keys for automatic failover. If a key is rate
# limited or rejected, the backend automatically retries with the next key.
# You can list them either as separate variables:
#   NASA_API_KEY_2=YOUR_SECOND_NASA_API_KEY_HERE
#   NASA_API_KEY_3=YOUR_THIRD_NASA_API_KEY_HERE
# ...or as a single comma-separated list:
#   NASA_API_KEYS=KEY_ONE,KEY_TWO,KEY_THREE
# Duplicate `NASA_API_KEY=` lines in .env are also picked up automatically.

# Optional: override the API base URL used by the frontend.
# Leave empty to use the Vite dev proxy (/api) locally.
# In production, point this at your deployed backend, e.g. https://your-backend.example.com/api
VITE_API_URL=

# ------------------------------------------------------------------
# Supabase configuration for NASA Research Assistant
# Supabase provides the database for 340 NASA research questions and
# persistent conversation history. Get your credentials from:
# https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
#
# Frontend variables (VITE_*):
#   VITE_SUPABASE_URL - Your Supabase project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY - Supabase anon/public key
#
# Backend variables:
#   SUPABASE_URL - Same as frontend URL
#   SUPABASE_ANON_KEY - Same as frontend anon key
#
# Note: The anon key is safe for both frontend and backend use when
# Row Level Security (RLS) is properly configured on Supabase.
VITE_SUPABASE_URL=https://wlpyytnbqtruposszrjn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://wlpyytnbqtruposszrjn.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server configuration
PORT=5001

# CORS allowlist - comma-separated list of front-end origins allowed to call the API.
# Origins are matched by scheme + hostname + port (see server/lib/origin.js), so
# trailing slashes and default ports are normalized. Unrecognized entries are
# dropped (a malformed list never becomes "allow everything").
# Defaults (when unset): production origin + localhost:5173, 5174, 3000, 4173.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:4173,https://astro-link-xi.vercel.app

# ------------------------------------------------------------------
# Optional: NASA FIRMS fire hotspots (server-side only).
# Needed for the FIRMS layer in the Geospatial Explorer and the observation
# provider in the Data Explorer. Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ------------------------------------------------------------------
# NASA Astrophysics Data System (ADS) — "Research Papers" page.
# ADS is a SEPARATE service run by Harvard/Smithsonian and does NOT accept the
# api.nasa.gov key. Register a free token at https://ui.adsabs.harvard.edu/
# (Account > Settings > API Token) and paste it here.
# When unset, the Research Papers page shows an honest "token not configured"
# notice and never displays sample or fabricated results.
ADS_API_KEY=
# Accepted alias: NASA_ADS_TOKEN

# ------------------------------------------------------------------
# CyberShield administrative access (server-side only).
# When ADMIN_TOKEN is empty/unset, the /api/cybershield/* admin endpoints are
# deny-by-default (403) and the monitoring dashboard cannot read metrics.
ADMIN_TOKEN=
# Optional: trusted IPs (comma-separated, e.g. health monitors) that are never
# counted toward abuse throttling.
TRUSTED_IPS=
# Optional: tune multi-signal abuse detection (defaults shown). At least
# ABUSE_SIGNALS_REQUIRED independent signals are needed before a restriction.
ABUSE_WINDOW_MS=300000
ABUSE_RATE_THRESHOLD=90
ABUSE_INVALID_THRESHOLD=12
ABUSE_PATH_THRESHOLD=8
ABUSE_SIGNALS_REQUIRED=2
# Progressive, auto-expiring restriction durations in seconds (capped).
ABUSE_RESTRICTION_STEPS=15,30,60,120,300

# ------------------------------------------------------------------
# Optional: override the two default API rate limits (requests / minute).
RATE_LIMIT_MAX=120
EXPENSIVE_RATE_LIMIT_MAX=20

# SECURITY NOTE: do NOT create VITE_* variables containing a private NASA key.
# Vite inlines VITE_* values into the public browser bundle. The frontend only
# ever uses NASA's public DEMO_KEY for direct client-side fallbacks.
